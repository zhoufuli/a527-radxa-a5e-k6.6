
#
#config file for sun60iw2
#
SUPPORT_BOARD=a537
ARCH = arm
PLATFORM = sun65iw1p1

CFG_BOOT0_RUN_ADDR=0x44000
CFG_SYS_INIT_RAM_SIZE=0x10000
CFG_FES1_RUN_ADDR=0x4c000
CFG_SBOOT_RUN_ADDR=0x44480

#gpio
CFG_SUNXI_GPIO_V2=y

#sunxi smc
CFG_SUNXI_SMC_30=y

#sunxi selet dram para
CFG_SUNXI_SELECT_DRAM_PARA=y

CFG_FPGA_PLATFORM=y
CFG_SUNXI_FPGA_BTIFILE_INIT_DRAM=y

CFG_SUNXI_CCI=y
