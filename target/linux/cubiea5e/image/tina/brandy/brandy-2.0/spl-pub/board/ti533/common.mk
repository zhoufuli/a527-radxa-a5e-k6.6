
#
#config file for sun55iw6
#
SUPPORT_BOARD=ti533 mr536 t536
ARCH = arm
PLATFORM = sun55iw6p1

CFG_BOOT0_RUN_ADDR=0x44000
CFG_SYS_INIT_RAM_SIZE=0x10000
CFG_FES1_RUN_ADDR=0x4c000
#need fix
CFG_SBOOT_RUN_ADDR=0x44480

#gpio
CFG_SUNXI_GPIO_V3=y

#power
CFG_SUNXI_POWER=y
CFG_SUNXI_TWI=y
CFG_SUNXI_PMIC=y
CFG_AXP2202_POWER=y
CFG_AXP1530_EXT_POWER=y

#chipid
CFG_SUNXI_CHIPID=y
CFG_SUNXI_EFUSE =y

#key
CFG_SUNXI_PHY_KEY=y
# CFG_LRADC_KEY=y
CFG_GPADC_KEY=y

#sunxi selet dram para
CFG_SUNXI_SELECT_DRAM_PARA=y

#sunxi smc
CFG_SUNXI_SMC_30=y

CFG_AW_CERT=y
CFG_X509_CERT_DISABLE=y

CFG_SUNXI_BOOT_PARAM=y
